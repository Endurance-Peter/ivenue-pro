{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Mobile: Expo Web",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://localhost:8082",
      "webRoot": "${workspaceFolder}/mobile",
      "preLaunchTask": "mobile: Expo web",
      "sourceMaps": true,
      "smartStep": true
    }
  ],
  "compounds": [
    {
      "name": "iVenue: Mobile + Backend",
      "configurations": ["Backend: FastAPI", "Mobile: Expo Web"],
      "stopAll": true
    }
  ]
}
